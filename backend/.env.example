# ============================================================================
# Variables de entorno del backend de Mykcal (EJEMPLO con valores inventados)
# Copia este archivo a .env y pon los valores reales. .env NO se sube a git.
# En Dokploy estas mismas variables se ponen en Application → Environment.
# ============================================================================

# --- Base de datos --------------------------------------------------------
# SECRETA. URL de conexión a PostgreSQL.
# Dokploy: servicio PostgreSQL → pestaña General → "Internal Connection URL".
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST_INTERNO:5432/BASE
# En local (docker-compose.dev.yml) vale la de abajo.
DATABASE_URL=postgresql://mykcal:cambia-esta-clave@mykcal-db-xxxxxx:5432/mykcal

# --- Zitadel (inicio de sesión) -------------------------------------------
# URL base de la instancia de Zitadel, sin "/" final y con https://.
# Es la misma que usas para entrar a la consola de Zitadel.
OIDC_ISSUER=https://zitadel.ejemplo.com

# ID del PROYECTO "mykcal". El backend comprueba que cada token traiga este
# valor en "aud". Dónde sacarlo: Zitadel → Projects → mykcal → "Resource Id"
# (arriba del todo, número largo). NO es el ID de la organización ni el de la app.
OIDC_PROJECT_ID=100000000000000001

# User ID de la persona administradora (la que genera el código de invitación).
# Dónde sacarlo: Zitadel → Users → tu usuario (en la organización "mykcal")
# → campo "User ID". Es el "sub" de sus tokens. No es su email.
ADMIN_SUBJECT=100000000000000002

# --- Entorno ---------------------------------------------------------------
# Solo se usa para etiquetar los logs: production | development
APP_ENV=production

# --- Opcionales (los valores por defecto sirven) ---------------------------
# Carpeta del volumen donde se guarda el APK que se descarga.
# APK_DIR=/data/apk
# Segundos máximos que puede tardar la migración al arrancar.
# MIGRATION_TIMEOUT_S=120
# Open Food Facts (feature 003, códigos de barras). Pide identificar la app; conviene
# añadir un contacto al final del valor.
# OFF_USER_AGENT=Mykcal/0.3 (app privada)
# OFF_BASE_URL=https://world.openfoodfacts.org
# Segundos máximos de espera a Open Food Facts (de 1 a 30).
# OFF_TIMEOUT_S=5

# --- IA (feature 006, registro por foto) -----------------------------------
# SECRETA. Clave maestra con la que se cifran las claves de IA de los usuarios.
# 32 bytes aleatorios en base64. Genérala con:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Si cambia, las claves guardadas dejan de poder descifrarse (cada usuario las vuelve a pegar).
AI_KEY_MASTER=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Modelo de Gemini y segundos máximos de espera (de 5 a 58).
# AI_MODEL=gemini-2.0-flash
# AI_TIMEOUT_S=55
